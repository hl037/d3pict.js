{
  "name": "d3pict",
  "version": "0.1.1",
  "description": "Depict your data: SVG charts built from objects, on top of d3. Interactive, animated, and yours to extend, in plain TypeScript, Vue or React.",
  "author": "Léo Flaventin Hauchecorne <hl037.prog@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hl037/d3pict.js.git"
  },
  "bugs": {
    "url": "https://github.com/hl037/d3pict.js/issues"
  },
  "homepage": "https://d3pict.dev/",
  "keywords": [
    "chart",
    "charts",
    "charting",
    "svg",
    "d3",
    "visualization",
    "polar",
    "vue",
    "react",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "vue": [
        "dist/vue.d.ts"
      ],
      "react": [
        "dist/react.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "examples": "vite --config examples/vite.config.ts",
    "examples:build": "vite build --config examples/vite.config.ts",
    "docs:api": "typedoc",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:pages": "pnpm docs:build && rsync -a --delete --exclude .git docs/.vitepress/dist/ pages.ignored/ && touch pages.ignored/.nojekyll",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "d3": "^7.9.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "d3": "^7.9.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^6.0.3",
    "unplugin-vue": "^8.0.0",
    "vite": "^8.3.4",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
