{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "noEmit": true,
    "paths": { "@/*": ["./src/*"], "d3pict": ["./src/index.ts"], "d3pict/vue": ["./src/vue/index.ts"], "d3pict/react": ["./src/react/index.ts"] }
  },
  "include": ["src", "test", "examples", "docs/.vitepress"]
}
